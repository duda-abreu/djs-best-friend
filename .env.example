# Credenciais do Spotify (crie um app gratis em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Pais e genero (7 = Dance/Eletronica) usados no grafico "mais tocadas" (feed
# publico da Apple) que alimenta a secao "em alta essa semana"
TRENDING_STOREFRONT=br
TRENDING_GENRE_ID=7

# Pasta onde os arquivos baixados ficam temporariamente antes de serem servidos
DOWNLOAD_DIR=downloads

# Quantas requisicoes de download cada IP pode fazer por minuto
RATE_LIMIT_PER_MINUTE=6

# Depois de quantos segundos um arquivo baixado (nao reclamado) e apagado
FILE_TTL_SECONDS=1800

# Se preenchidos, exige login HTTP Basic pra acessar o site (use ao hospedar
# publicamente, ex: Railway — deixe em branco pra uso local sem senha)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
