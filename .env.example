# Credenciais do Spotify (crie um app gratis em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Chave gratis do Last.fm (last.fm/api/account/create) pra alimentar o "em
# alta essa semana" com dados reais de audicao (house/techno), atualizado
# automaticamente. Sem isso, cai pra uma lista fixa de artistas conhecidos.
LASTFM_API_KEY=

# Opcional: ID de uma playlist do Spotify (ex: a "mint") pra usar ao vivo em
# vez do grafico da Apple. So funciona com login feito (/auth/login) — pegue
# o ID abrindo a playlist no Spotify, Compartilhar > Copiar link, e usando a
# parte depois de open.spotify.com/playlist/
SPOTIFY_TRENDING_PLAYLIST_ID=

# Pasta onde os arquivos baixados ficam temporariamente antes de serem servidos
DOWNLOAD_DIR=downloads

# Quantas requisicoes de download cada IP pode fazer por minuto
RATE_LIMIT_PER_MINUTE=6

# Depois de quantos segundos um arquivo baixado (nao reclamado) e apagado
FILE_TTL_SECONDS=1800

# Se preenchidos, exige login HTTP Basic pra acessar o site (use ao hospedar
# publicamente, ex: Railway — deixe em branco pra uso local sem senha)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
